diff --git a/Components/Include/StageProfile.h b/Components/Include/StageProfile.h
new file mode 100644
index 0000000..4601969
--- /dev/null
+++ b/Components/Include/StageProfile.h
@@ -0,0 +1,42 @@
+#pragma once
+// Lab-only inclusive elapsed counters. Parallel/nested totals MUST NOT be added.
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <cstdint>
+#include <utility>
+namespace vsf_profile {
+enum Bin { search, step, decode, demux, copy_frame, bgr, sws_init, sws_scale_bin, transform, save_images, count };
+struct Counter { std::atomic<std::uint64_t> calls{0}, ns{0}; };
+inline Counter* counters() { static Counter values[count]; return values; }
+inline const char* destination() { static const char* value = std::getenv("VSF_PROFILE_JSON"); return value; }
+struct Scope {
+    Bin bin; bool active; std::chrono::steady_clock::time_point start;
+    explicit Scope(Bin b): bin(b), active(destination() && *destination()) {
+        if (active) start = std::chrono::steady_clock::now();
+    }
+    ~Scope() noexcept {
+        if (!active) return;
+        const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();
+        counters()[bin].calls.fetch_add(1, std::memory_order_relaxed);
+        counters()[bin].ns.fetch_add(static_cast<std::uint64_t>(ns), std::memory_order_relaxed);
+    }
+};
+template<class F> inline auto measure(Bin b, F&& fn) -> decltype(fn()) {
+    Scope timer(b); return std::forward<F>(fn)();
+}
+inline void dump() noexcept {
+    if (!destination() || !*destination()) return;
+    try {
+        std::ofstream stream(destination());
+        const char* names[count] = {"search_inclusive", "decode_step_inclusive", "decode_frame_inclusive", "demux_read", "frame_copy", "bgr_inclusive", "sws_context_create", "sws_scale", "transform_inclusive", "image_save_task_inclusive"};
+        stream << "{\"version\":1,\"semantics\":\"inclusive elapsed; nested and concurrent; not CPU or additive wall time\",\"stages\":[";
+        for (int i=0; i<count; ++i) {
+            if(i) stream << ',';
+            stream << "{\"name\":\"" << names[i] << "\",\"calls\":" << counters()[i].calls.load() << ",\"nanoseconds\":" << counters()[i].ns.load() << '}';
+        }
+        stream << "]}";
+    } catch (...) { /* Profiling must not replace the pipeline's error handling. */ }
+}
+}
